---
import '../styles/global.css';
import MobileNav from '../components/MobileNav.astro';
import AgeGate from '../components/AgeGate.astro';
import SEO from '../components/SEO.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'product';
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, type, jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL;
const [{ data: info }] = await getCollection('info');
const phoneHref = `tel:+385${info.phone.replace(/\s+/g, '').replace(/^0/, '')}`;
const footerLinks = [
  { href: base, label: 'Početna' },
  { href: `${base}products`, label: 'Proizvodi' },
  { href: `${base}contact`, label: 'Kontakt' },
  { href: `${base}policy`, label: 'Pravila' },
];
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <SEO title={title} description={description} image={image} type={type} jsonLd={jsonLd} />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <header class="sticky top-0 z-50 bg-card/95 backdrop-blur border-b border-border">
      <MobileNav />
    </header>

    <AgeGate />

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-ink text-ink-foreground px-4 md:px-8 pt-14 pb-8">
      <div class="max-w-6xl mx-auto">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          <div class="lg:col-span-1">
            <p class="font-display text-2xl font-semibold text-white">Gift Shop Bjelovar</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{info.address}</p>
            <div class="mt-5 [&_a]:text-ink-muted [&_a:hover]:text-white">
              <SocialLinks facebook={info.social.facebook} instagram={info.social.instagram} />
            </div>
          </div>

          <div>
            <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">Kontakt</h2>
            <ul class="mt-4 space-y-2 text-sm">
              <li><a href={phoneHref} class="hover:text-white transition-colors">{info.phone}</a></li>
              <li><a href={`mailto:${info.email}`} class="hover:text-white transition-colors break-all">{info.email}</a></li>
            </ul>
          </div>

          <div>
            <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">Radno vrijeme</h2>
            <dl class="mt-4 space-y-2 text-sm">
              {info.workingHours.map(({ day, hours }) => (
                <div class="flex justify-between gap-4">
                  <dt class="text-ink-muted">{day}</dt>
                  <dd>{hours}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div>
            <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">Stranice</h2>
            <ul class="mt-4 space-y-2 text-sm">
              {footerLinks.map(({ href, label }) => (
                <li><a href={href} class="hover:text-white transition-colors">{label}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <p class="mt-12 pt-6 border-t border-white/10 text-xs text-ink-muted">
          &copy; {new Date().getFullYear()} Gift Shop Bjelovar. Sva prava pridržana.
        </p>
      </div>
    </footer>
  </body>
</html>
