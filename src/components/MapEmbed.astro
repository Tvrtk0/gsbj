---
interface Props {
  url: string;
}

const { url } = Astro.props;
---

<div class="aspect-[4/3] sm:aspect-video w-full bg-muted">
  <iframe
    src={url}
    class="block w-full h-full"
    style="border:0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title="Lokacija Gift Shop Bjelovar"
  ></iframe>
</div>
