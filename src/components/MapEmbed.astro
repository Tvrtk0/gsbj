---
interface Props {
  url: string;
}

const { url } = Astro.props;
---

<div class="aspect-video w-full rounded-lg overflow-hidden border border-border">
  <iframe
    src={url}
    width="100%"
    height="100%"
    style="border:0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title="Lokacija Gift Shop Bjelovar"
  ></iframe>
</div>
