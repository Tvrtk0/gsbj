---
import { navLinks, isActive } from '../lib/nav';

const pathname = Astro.url.pathname;

const icons: Record<(typeof navLinks)[number]['icon'], string> = {
  home: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1v-9.5Z',
  grid: 'M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z',
  // A pin, not a phone: the page is mostly map, address and hours, and a phone reads as "this will call"
  pin: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
};
---

{/* Phone-only tab bar, fixed under the thumb. Desktop uses the header links. */}
<nav
  style="view-transition-name: bottom-nav"
  class="md:hidden fixed inset-x-0 bottom-0 z-40 bg-card/95 backdrop-blur border-t border-border pb-[env(safe-area-inset-bottom)]"
  aria-label="Glavna navigacija"
>
  <ul class="grid grid-cols-3">
    {navLinks.map(({ href, label, icon }) => {
      const active = isActive(href, pathname);
      return (
        <li>
          <a
            href={href}
            class:list={[
              'press relative flex flex-col items-center gap-1 pt-2.5 pb-2 text-xs font-medium',
              active ? 'text-primary' : 'text-muted-foreground',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {active && <span class="nav-marker-bottom absolute top-0 h-0.5 w-10 rounded-full bg-primary" />}
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={icons[icon]} />
            </svg>
            {label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
