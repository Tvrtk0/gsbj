---
import { navLinks, isActive } from '../lib/nav';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
---

{/* Phones navigate with BottomNav, so the header is just the logo there */}
<nav class="max-w-6xl mx-auto flex items-center justify-between px-4 py-3.5 md:px-8 lg:px-0">
  <a href={base} class="font-display text-xl md:text-2xl font-semibold tracking-tight text-primary">Gift Shop Bjelovar</a>

  <ul class="hidden md:flex gap-8">
    {navLinks.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class:list={[
            'relative text-[15px] font-medium transition-colors hover:text-primary',
            isActive(href, pathname) ? 'text-primary' : 'text-foreground',
          ]}
          aria-current={isActive(href, pathname) ? 'page' : undefined}
        >
          {label}
          {isActive(href, pathname) && (
            <span class="nav-marker-top absolute -bottom-1.5 inset-x-0 h-0.5 rounded-full bg-primary" />
          )}
        </a>
      </li>
    ))}
  </ul>
</nav>
