---
interface Category {
  slug: string;
  name: string;
  count: number;
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
const total = categories.reduce((sum, c) => sum + c.count, 0);
---

{/* Behaviour lives in src/scripts/catalog.ts. One swipeable row on phones (full-bleed so it scrolls to the screen edge), wrapping rows from md up */}
<div
  class="no-scrollbar -mx-4 px-4 md:mx-0 md:px-0 flex gap-2 overflow-x-auto md:flex-wrap md:overflow-visible mb-8"
  id="category-filter"
>
  {[{ slug: 'all', name: 'Sve', count: total }, ...categories].map((cat) => (
    <button
      class:list={[
        'filter-btn shrink-0 inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-full border whitespace-nowrap transition-colors',
        cat.slug === 'all'
          ? 'active border-primary bg-primary text-primary-foreground'
          : 'border-border bg-card text-card-foreground',
      ]}
      data-category={cat.slug}
    >
      {cat.name}
      <span class="text-xs opacity-60 tabular-nums">{cat.count}</span>
    </button>
  ))}
</div>
