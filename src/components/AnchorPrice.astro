---
/**
 * The anchor price ("sidrena cijena", NN 101/2026): what this product cost on the reference
 * date, or on the day it was introduced. The Ministry's guidance is that the date alone
 * identifies it. Shown as a neutral note, never struck through: it isn't a discount.
 */
import { anchorFor } from '../lib/priceHistory';
import { formatDateHr, formatPrice, formatPriceFrom } from '../lib/price';

interface Props {
  slug: string;
  price: number;
  priceMax?: number;
  variant?: 'card' | 'detail';
  class?: string;
  style?: string;
}

const { slug, price, priceMax, variant = 'card', class: className, style } = Astro.props;
const anchor = anchorFor(slug, { price, priceMax });
const date = formatDateHr(anchor.date);
const amount = variant === 'card' ? formatPriceFrom(anchor.price, anchor.priceMax) : formatPrice(anchor.price, anchor.priceMax);
const label = `Cijena na dan ${date} iznosila je ${amount}`;
const calendar =
  'M8 3v3m8-3v3M4.5 9h15M6 5h12a1.5 1.5 0 0 1 1.5 1.5V19a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 19V6.5A1.5 1.5 0 0 1 6 5Z';
---

{
  variant === 'detail' ? (
    // Secondary to the current price above it: one muted line, no box, no bold
    <p
      class:list={['flex flex-wrap items-center gap-x-1.5 text-sm text-muted-foreground', className]}
      style={style}
      title={label}
      data-pagefind-ignore
    >
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d={calendar} />
      </svg>
      <span class="whitespace-nowrap">Cijena na dan {date}</span>
      <span class="whitespace-nowrap tabular-nums">{amount}</span>
    </p>
  ) : (
    <p
      class:list={['flex flex-wrap items-center gap-x-1 text-xs text-muted-foreground', className]}
      style={style}
      title={label}
    >
      <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d={calendar} />
      </svg>
      <span class="sr-only">Cijena na dan</span>
      <span class="whitespace-nowrap">{date}</span>
      <span class="whitespace-nowrap font-medium text-foreground/75 tabular-nums">{amount}</span>
    </p>
  )
}
