---
const base = import.meta.env.BASE_URL;
const links = [
  { href: base, label: 'Početna' },
  { href: `${base}products`, label: 'Proizvodi' },
  { href: `${base}contact`, label: 'Kontakt' },
];
// Paths end in a slash on the built site but not in `links`; product pages count as Proizvodi
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = href.replace(/\/$/, '');
  return target === base.replace(/\/$/, '') ? currentPath === target : currentPath.startsWith(target);
};
---

<nav class="max-w-6xl mx-auto flex items-center justify-between px-4 py-3.5 md:px-8 lg:px-0">
  <a href={base} class="font-display text-xl md:text-2xl font-semibold tracking-tight text-primary">Gift Shop Bjelovar</a>

  {/* Desktop nav */}
  <ul class="hidden md:flex gap-8">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class:list={[
            'text-[15px] font-medium transition-colors hover:text-primary',
            isActive(href) ? 'text-primary' : 'text-foreground',
          ]}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>

  {/* Mobile hamburger */}
  <button
    id="mobile-menu-btn"
    class="md:hidden p-2 text-foreground"
    aria-label="Otvori izbornik"
    aria-expanded="false"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</nav>

{/* Mobile menu */}
<div id="mobile-menu" class="hidden md:hidden border-b border-border bg-card">
  <ul class="flex flex-col px-4 py-2">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class:list={[
            'block py-3 text-base font-medium transition-colors hover:text-primary',
            isActive(href) ? 'text-primary' : 'text-foreground',
          ]}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!open));
  });
</script>
