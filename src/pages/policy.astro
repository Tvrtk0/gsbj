---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const [info] = await getCollection('info');
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Pravila i uvjeti" description="Pravila korištenja, dobno ograničenje i informacije o prodaji.">
  {/* Header */}
  <section class="relative overflow-hidden bg-gradient-to-br from-secondary/10 via-muted/30 to-background pt-24 pb-16 md:pt-32 md:pb-24 px-4 md:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <span class="inline-block text-sm font-medium tracking-wider uppercase text-secondary mt-8 mb-3">Pravne informacije</span>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight">Pravila i uvjeti</h1>
      <p class="mt-4 text-muted-foreground max-w-xl mx-auto">Informacije o korištenju stranice, dobnom ograničenju i prodaji proizvoda.</p>
    </div>
  </section>

  <section class="py-12 md:py-16 px-4 md:px-8">
    <div class="max-w-2xl mx-auto space-y-6">

      {/* O stranici */}
      <div class="bg-card border border-border rounded-xl p-6 md:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h2 class="text-lg font-bold">O stranici</h2>
        </div>
        <p class="text-muted-foreground leading-relaxed">
          Ova web stranica služi isključivo kao <strong class="text-foreground">izlog proizvoda</strong> trgovine {info.data.businessName}.
          Putem ove stranice <strong class="text-foreground">nije moguće izvršiti kupnju</strong> niti naručiti proizvode online.
          Svi proizvodi dostupni su isključivo u našoj fizičkoj trgovini na adresi: <strong class="text-foreground">{info.data.address}</strong>.
        </p>
      </div>

      {/* Dobno ograničenje */}
      <div class="bg-card border border-border rounded-xl p-6 md:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-red-500/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          </div>
          <h2 class="text-lg font-bold">Dobno ograničenje — 18+</h2>
        </div>
        <p class="text-muted-foreground leading-relaxed">
          Dio asortimana uključuje <strong class="text-foreground">duhanske proizvode, elektronske cigarete, tekućine za elektronske cigarete
          i pušački pribor</strong>. Sukladno <strong class="text-foreground">Zakonu o ograničavanju uporabe duhanskih i srodnih proizvoda
          (NN 45/17, 114/18)</strong>, ovi proizvodi namijenjeni su isključivo osobama starijima od 18 godina.
        </p>
        <p class="text-muted-foreground leading-relaxed mt-3">
          Prodaja duhanskih i srodnih proizvoda osobama mlađima od 18 godina zabranjena je zakonom.
          Prilikom kupnje u trgovini, prodavač ima pravo zatražiti predočenje osobne iskaznice
          radi provjere dobi kupca.
        </p>
      </div>

      {/* Zdravstvena upozorenja */}
      <div class="bg-gradient-to-r from-red-950 to-red-900 border border-red-800 rounded-xl p-6 md:p-8 text-white">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-red-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
          </div>
          <h2 class="text-lg font-bold">Zdravstvena upozorenja</h2>
        </div>
        <p class="text-xl font-bold mb-3">
          Pušenje ubija. Prestanite sada.
        </p>
        <p class="text-red-200 leading-relaxed text-sm">
          Duhanski proizvodi i elektronske cigarete sadrže nikotin koji uzrokuje ovisnost i štetan je za zdravlje.
          Elektronske cigarete nisu bezopasna alternativa klasičnim cigaretama.
          Za pomoć pri prestanku pušenja posjetite svog liječnika ili nazovite savjetovalište.
        </p>
      </div>

      {/* Cijene i dostupnost + Fotografije — side by side on desktop */}
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-card border border-border rounded-xl p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
            </div>
            <h2 class="text-lg font-bold">Cijene</h2>
          </div>
          <p class="text-muted-foreground leading-relaxed text-sm">
            Sve cijene izražene su u eurima (EUR) i uključuju PDV.
            Cijene su <strong class="text-foreground">informativnog karaktera</strong> i mogu se razlikovati od cijena u trgovini.
          </p>
        </div>

        <div class="bg-card border border-border rounded-xl p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <h2 class="text-lg font-bold">Fotografije</h2>
          </div>
          <p class="text-muted-foreground leading-relaxed text-sm">
            Fotografije služe u <strong class="text-foreground">informativne svrhe</strong>. Stvarni izgled proizvoda
            može se neznatno razlikovati od prikazanog.
          </p>
        </div>
      </div>

      {/* Kontakt */}
      <div class="bg-card border border-border rounded-xl p-6 md:p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <h2 class="text-lg font-bold">Kontakt</h2>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-muted-foreground mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="text-sm text-muted-foreground">{info.data.address}</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-muted-foreground shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <a href={`tel:${info.data.phone}`} class="text-sm text-primary hover:underline">{info.data.phone}</a>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-muted-foreground shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href={`mailto:${info.data.email}`} class="text-sm text-primary hover:underline">{info.data.email}</a>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-muted-foreground shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
            <a href={base} class="text-sm text-primary hover:underline">{info.data.businessName}</a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
