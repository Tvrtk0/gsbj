---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import WorkingHours from '../components/WorkingHours.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products', ({ data }) => !data.archive);
const categories = await getCollection('categories');
const [info] = await getCollection('info');

const categoryMap = new Map(categories.map((c) => [c.data.slug, c.data.name]));
const base = import.meta.env.BASE_URL;

// Pick 8 random products for the featured section
const shuffled = [...allProducts].sort(() => Math.random() - 0.5);
const featuredProducts = shuffled.slice(0, 8);

// Pick 4 popular categories to showcase
const categoryCounts = new Map<string, number>();
for (const p of allProducts) {
  categoryCounts.set(p.data.category, (categoryCounts.get(p.data.category) || 0) + 1);
}
const topCategories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([slug, count]) => ({ slug, name: categoryMap.get(slug) || slug, count }));
---

<BaseLayout
  title="Gift Shop Bjelovar"
  description={info.data.aboutText}
>
  {/* Hero */}
  <section class="relative overflow-hidden bg-gradient-to-br from-primary/10 via-accent/10 to-background py-20 md:py-32 px-4 md:px-8">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 25% 50%, var(--color-primary) 0%, transparent 50%), radial-gradient(circle at 75% 50%, var(--color-accent) 0%, transparent 50%);"></div>
    <div class="relative max-w-4xl mx-auto text-center">
      <span class="inline-block text-sm font-medium tracking-wider uppercase text-primary mb-4">Dobrodošli u</span>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-foreground tracking-tight">
        Gift Shop<br/>
        <span class="text-primary">Bjelovar</span>
      </h1>
      <p class="mt-6 text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        {info.data.aboutText}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`${base}products`}
          class="inline-flex items-center justify-center px-8 py-3.5 bg-primary text-primary-foreground font-medium rounded-lg hover:opacity-90 transition-all hover:shadow-lg hover:shadow-primary/25"
        >
          Pogledaj proizvode
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a
          href={`${base}contact`}
          class="inline-flex items-center justify-center px-8 py-3.5 border-2 border-border text-foreground font-medium rounded-lg hover:border-primary hover:text-primary transition-colors"
        >
          Kontaktiraj nas
        </a>
      </div>
    </div>
  </section>

  {/* Stats bar */}
  <section class="bg-card border-y border-border">
    <div class="max-w-6xl mx-auto grid grid-cols-3 divide-x divide-border">
      <div class="py-6 md:py-8 text-center">
        <p class="text-2xl md:text-3xl font-bold text-primary">{allProducts.length}+</p>
        <p class="text-xs md:text-sm text-muted-foreground mt-1">Proizvoda</p>
      </div>
      <div class="py-6 md:py-8 text-center">
        <p class="text-2xl md:text-3xl font-bold text-primary">{categories.length}</p>
        <p class="text-xs md:text-sm text-muted-foreground mt-1">Kategorija</p>
      </div>
      <div class="py-6 md:py-8 text-center">
        <p class="text-2xl md:text-3xl font-bold text-primary">
          <svg class="w-6 h-6 md:w-8 md:h-8 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </p>
        <p class="text-xs md:text-sm text-muted-foreground mt-1">Bjelovar</p>
      </div>
    </div>
  </section>

  {/* Browse by category */}
  <section class="py-14 md:py-20 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold">Pretraži po kategoriji</h2>
        <p class="text-muted-foreground mt-2">Pronađite upravo ono što tražite</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
        {topCategories.map((cat) => (
          <a
            href={`${base}products?category=${cat.slug}`}
            class="group relative flex items-center gap-3 p-4 md:p-5 bg-card border border-border rounded-xl hover:border-primary hover:shadow-md transition-all"
          >
            <div class="flex-1">
              <h3 class="font-semibold text-card-foreground group-hover:text-primary transition-colors">{cat.name}</h3>
              <p class="text-sm text-muted-foreground">{cat.count} proizvoda</p>
            </div>
            <svg class="w-5 h-5 text-muted-foreground group-hover:text-primary group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Featured products */}
  <section class="py-14 md:py-20 px-4 md:px-8 bg-gradient-to-b from-background to-card/50">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold">Izdvojeni proizvodi</h2>
          <p class="text-muted-foreground mt-1">Iz naše ponude</p>
        </div>
        <a
          href={`${base}products`}
          class="hidden md:inline-flex items-center text-sm font-medium text-primary hover:underline"
        >
          Pogledaj sve
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {featuredProducts.map((product) => (
          <ProductCard
            name={product.data.name}
            slug={product.id}
            price={product.data.price}
            image={product.data.image}
            category={product.data.category}
            categoryName={categoryMap.get(product.data.category)}
          />
        ))}
      </div>
      <div class="text-center mt-8 md:hidden">
        <a
          href={`${base}products`}
          class="inline-flex items-center text-sm font-medium text-primary hover:underline"
        >
          Pogledaj sve proizvode
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  {/* Info + Working hours */}
  <section class="py-14 md:py-20 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8">
        {/* Working hours card */}
        <div class="bg-card border border-border rounded-xl p-6 md:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h2 class="text-xl font-bold">Radno vrijeme</h2>
          </div>
          <WorkingHours hours={info.data.workingHours} />
        </div>

        {/* Contact info card */}
        <div class="bg-card border border-border rounded-xl p-6 md:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <h2 class="text-xl font-bold">Kontakt</h2>
          </div>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-muted-foreground mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <p class="text-sm text-muted-foreground">{info.data.address}</p>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-muted-foreground shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <a href={`tel:${info.data.phone}`} class="text-sm text-primary hover:underline">{info.data.phone}</a>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-muted-foreground shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <a href={`mailto:${info.data.email}`} class="text-sm text-primary hover:underline">{info.data.email}</a>
            </div>
            <div class="pt-2">
              <SocialLinks facebook={info.data.social.facebook} instagram={info.data.social.instagram} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
