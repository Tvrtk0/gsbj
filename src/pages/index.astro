---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import WorkingHours from '../components/WorkingHours.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products', ({ data }) => !data.archive);
const categories = await getCollection('categories');
const [info] = await getCollection('info');

const categoryMap = new Map(categories.map((c) => [c.data.slug, c.data.name]));

const base = import.meta.env.BASE_URL;
// Show up to 8 products on homepage
const featuredProducts = allProducts.slice(0, 8);
---

<BaseLayout
  title="Gift Shop Bjelovar"
  description={info.data.aboutText}
>
  {/* Hero */}
  <section class="py-12 md:py-20 px-4 md:px-8 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-bold text-foreground">
        {info.data.businessName}
      </h1>
      <p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto">
        {info.data.aboutText}
      </p>
      <a
        href={`${base}products`}
        class="inline-block mt-6 px-6 py-3 bg-primary text-primary-foreground font-medium rounded-md hover:opacity-90 transition-opacity"
      >
        Pogledaj proizvode
      </a>
    </div>
  </section>

  {/* Working hours */}
  <section class="py-10 px-4 md:px-8 bg-card border-y border-border">
    <div class="max-w-md mx-auto">
      <h2 class="text-xl font-semibold text-center mb-4">Radno vrijeme</h2>
      <WorkingHours hours={info.data.workingHours} />
    </div>
  </section>

  {/* Featured products */}
  <section class="py-12 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-semibold mb-6">Izdvojeni proizvodi</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {featuredProducts.map((product) => (
          <ProductCard
            name={product.data.name}
            slug={product.id}
            price={product.data.price}
            image={product.data.image}
            category={product.data.category}
            categoryName={categoryMap.get(product.data.category)}
          />
        ))}
      </div>
      <div class="text-center mt-8">
        <a
          href={`${base}products`}
          class="inline-block px-6 py-3 border border-primary text-primary font-medium rounded-md hover:bg-primary hover:text-primary-foreground transition-colors"
        >
          Svi proizvodi
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
