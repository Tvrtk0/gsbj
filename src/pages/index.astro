---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';

const byNewest = <T extends { data: { date: Date } }>(a: T, b: T) =>
  b.data.date.getTime() - a.data.date.getTime();

const allProducts = (await getCollection('products', ({ data }) => !data.archive)).sort(byNewest);
const categories = await getCollection('categories');
const [info] = await getCollection('info');

const categoryMap = new Map(categories.map((c) => [c.data.slug, c.data.name]));
const base = import.meta.env.BASE_URL;

// Hero collage: hand-picked for clean white-background photos that read as gifts.
// A slug that's deleted or archived just drops out.
const HERO_PRODUCTS = [
  'casio-muski-rucni-sat',
  'salica-keramicka-s-tiskom-u-poklon-kutiji-narancasto-roza-sefica',
  'poklon-kutijica-drvena-s-tiskom-sretan-rodendan',
  'sah',
];
const heroProducts = HERO_PRODUCTS.map((slug) => allProducts.find((p) => p.id === slug)).filter(
  (p) => p !== undefined
);

const featuredProducts = allProducts.slice(0, 8);

const categoryCounts = new Map<string, number>();
for (const p of allProducts) {
  categoryCounts.set(p.data.category, (categoryCounts.get(p.data.category) || 0) + 1);
}
const topCategories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([slug, count]) => ({ slug, name: categoryMap.get(slug) || slug, count }));

const phoneHref = `tel:+385${info.data.phone.replace(/\s+/g, '').replace(/^0/, '')}`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${info.data.businessName}, ${info.data.address}`
)}`;
---

<BaseLayout title="Gift Shop Bjelovar" description={info.data.aboutText}>
  {/* Hero */}
  <section class="relative overflow-hidden bg-gradient-to-br from-tint/70 via-background to-background px-4 md:px-8">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-center py-14 md:py-20">
      <div class="text-center lg:text-left">
        <span class="inline-block text-xs font-semibold tracking-[0.16em] uppercase text-primary mb-4">
          Dobrodošli u
        </span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl leading-[1.02] text-foreground">
          Gift Shop <span class="text-primary">Bjelovar</span>
        </h1>
        <p class="mt-6 text-lg text-muted-foreground max-w-xl mx-auto lg:mx-0 leading-relaxed">
          {info.data.aboutText}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
          <a
            href={`${base}products`}
            class="inline-flex items-center justify-center px-7 py-3.5 bg-primary text-primary-foreground font-medium rounded-xl hover:bg-primary-hover transition-colors shadow-sm shadow-primary/20"
          >
            Pogledaj proizvode
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a
            href={`${base}contact`}
            class="inline-flex items-center justify-center px-7 py-3.5 bg-card border border-border text-foreground font-medium rounded-xl hover:border-primary hover:text-primary transition-colors"
          >
            Kontaktiraj nas
          </a>
        </div>
      </div>

      {/* Collage: desktop only, where it sits beside the text; stacked under it on phones it just pushes content down */}
      <div class="hidden lg:grid grid-cols-2 gap-4 w-full">
        {heroProducts.map((p, i) => (
          <a
            href={`${base}products/${p.id}`}
            class:list={[
              'group aspect-square rounded-2xl bg-card p-4 md:p-6 shadow-sm ring-1 ring-border/60 transition-transform hover:-translate-y-1',
              i % 2 === 1 && 'lg:translate-y-6',
            ]}
          >
            <img
              src={p.data.image}
              alt={p.data.name}
              class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Visit info: practical, instead of vanity stats */}
  <section class="bg-card border-y border-border px-4 md:px-8">
    <div class="max-w-6xl mx-auto grid sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-border">
      <div class="flex items-center gap-3 py-5 sm:pr-6">
        <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="text-sm">
          <span id="today-hours" data-hours={JSON.stringify(info.data.workingHours)} class="font-medium">Radno vrijeme</span>
          <a href={`${base}contact`} class="block text-muted-foreground hover:text-primary transition-colors">Cijeli raspored</a>
        </p>
      </div>
      <a href={directionsHref} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 py-5 sm:px-6">
        <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <p class="text-sm">
          <span class="font-medium group-hover:text-primary transition-colors">{info.data.address}</span>
          <span class="block text-muted-foreground">Upute za dolazak</span>
        </p>
      </a>
      <a href={phoneHref} class="group flex items-center gap-3 py-5 sm:pl-6">
        <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <p class="text-sm">
          <span class="font-medium group-hover:text-primary transition-colors">{info.data.phone}</span>
          <span class="block text-muted-foreground">Nazovite nas</span>
        </p>
      </a>
    </div>
  </section>

  {/* Browse by category */}
  <section class="py-14 md:py-20 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="mb-8 md:mb-10">
        <h2 class="text-3xl md:text-4xl">Pretraži po kategoriji</h2>
        <p class="text-muted-foreground mt-2">Pronađite upravo ono što tražite</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
        {topCategories.map((cat) => (
          <a
            href={`${base}products?category=${cat.slug}`}
            class="group flex items-center gap-3 p-4 md:p-5 bg-card rounded-xl ring-1 ring-border/60 hover:ring-primary hover:shadow-md transition-all"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-sans font-semibold text-card-foreground group-hover:text-primary transition-colors tracking-normal">{cat.name}</h3>
              <p class="text-sm text-muted-foreground">{cat.count} proizvoda</p>
            </div>
            <svg class="w-5 h-5 shrink-0 text-muted-foreground group-hover:text-primary group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Featured products: the most recently published */}
  <section class="pb-14 md:pb-20 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-8 md:mb-10">
        <div>
          <h2 class="text-3xl md:text-4xl">Izdvojeni proizvodi</h2>
          <p class="text-muted-foreground mt-2">Iz naše ponude</p>
        </div>
        <a
          href={`${base}products`}
          class="hidden md:inline-flex items-center text-sm font-medium text-primary hover:text-primary-hover"
        >
          Pogledaj sve
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {featuredProducts.map((product) => (
          <ProductCard
            name={product.data.name}
            slug={product.id}
            price={product.data.price}
            priceMax={product.data.priceMax}
            image={product.data.image}
            category={product.data.category}
          />
        ))}
      </div>
      <div class="text-center mt-8 md:hidden">
        <a
          href={`${base}products`}
          class="inline-flex items-center justify-center w-full px-6 py-3 bg-card border border-border rounded-xl text-sm font-medium text-primary"
        >
          Pogledaj sve proizvode
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { hoursForDate, isClosed } from '../lib/hours';

  // Fill in today's hours for the visitor's day; leaves the generic label if the hours can't be read
  const el = document.getElementById('today-hours');
  if (el?.dataset.hours) {
    const hours = hoursForDate(JSON.parse(el.dataset.hours), new Date());
    if (hours) el.textContent = isClosed(hours) ? 'Danas zatvoreno' : `Danas otvoreno ${hours}`;
  }
</script>
