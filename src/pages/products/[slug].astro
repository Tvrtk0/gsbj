---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection, render } from 'astro:content';
import { productImageTransition } from '../../lib/transition';
import { responsiveImage, SIZES } from '../../lib/images';
import { formatPrice, formatAnchor } from '../../lib/price';
import { anchorFor } from '../../lib/priceHistory';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => !data.archive);
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { data } = product;
const { Content } = await render(product);
const base = import.meta.env.BASE_URL;
const img = responsiveImage(data.image);
const anchor = anchorFor(product.id, { price: data.price, priceMax: data.priceMax });

const allProducts = await getCollection('products', ({ data: d }) => !d.archive);
const categories = await getCollection('categories');
const category = categories.find((c) => c.data.slug === data.category);

// 4 suggestions: same category first (that's what someone looking at this wants), topped up
// from the rest when the category is small. Shuffled per build.
const shuffle = <T,>(xs: T[]) => xs.sort(() => Math.random() - 0.5);
const others = allProducts.filter((p) => p.id !== product.id);
const suggestions = [
  ...shuffle(others.filter((p) => p.data.category === data.category)),
  ...shuffle(others.filter((p) => p.data.category !== data.category)),
].slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.name,
  description: product.body?.trim() || data.name,
  image: new URL(data.image, Astro.site).href,
  offers:
    data.priceMax === undefined
      ? {
          '@type': 'Offer',
          price: data.price.toFixed(2),
          priceCurrency: 'EUR',
          availability: 'https://schema.org/InStock',
        }
      : {
          '@type': 'AggregateOffer',
          lowPrice: data.price.toFixed(2),
          highPrice: data.priceMax.toFixed(2),
          priceCurrency: 'EUR',
          availability: 'https://schema.org/InStock',
        },
};
---

<BaseLayout
  title={data.name}
  description={product.body?.trim() || data.name}
  image={data.image}
  type="product"
  jsonLd={jsonLd}
>
  <section class="py-10 px-4 md:px-8" data-pagefind-body>
    <div class="max-w-5xl mx-auto">
      <a id="back-link" href={`${base}products`} class="text-sm text-muted-foreground hover:text-primary transition-colors mb-4 inline-block" data-pagefind-ignore>
        &larr; Natrag na proizvode
      </a>

      <div class="grid md:grid-cols-2 gap-8 lg:gap-14 mt-4">
        <div class="aspect-square overflow-hidden rounded-2xl ring-1 ring-border/60 bg-card p-6 md:p-8 md:sticky md:top-24 self-start">
          <img
            src={img.src}
            srcset={img.srcset}
            sizes={SIZES.detail}
            alt={data.name}
            fetchpriority="high"
            class="w-full h-full object-contain"
            style={productImageTransition(product.id)}
            data-pagefind-meta="image[src], image_alt[alt]"
          />
        </div>

        <div>
          {category && (
            <a
              href={`${base}products?category=${data.category}`}
              class="animate-enter inline-block text-xs font-semibold text-primary bg-tint px-2.5 py-1 rounded-full hover:bg-accent/60 transition-colors"
              style="--i: 0"
            >
              {category.data.name}
            </a>
          )}

          <h1 class="animate-enter text-[1.75rem] md:text-3xl lg:text-[2.25rem] leading-tight mt-3" style="--i: 1">{data.name}</h1>

          <p class="animate-enter text-2xl font-semibold text-primary mt-4" style="--i: 2">
            {formatPrice(data.price, data.priceMax)}
          </p>
          {/* Anchor price (NN 101/2026); kept out of the search index */}
          <p class="animate-enter mt-1 text-sm text-muted-foreground" style="--i: 2" data-pagefind-ignore>
            {formatAnchor(anchor)}
          </p>

          <div class="animate-enter mt-6 text-[15px] md:text-base leading-7 text-foreground/80 whitespace-pre-line" style="--i: 3">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-10 px-4 md:px-8 border-t border-border" data-pagefind-ignore>
    <div class="max-w-5xl mx-auto">
      <h2 data-reveal class="text-2xl md:text-3xl mb-6">Možda vas zanima</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {suggestions.map((p) => (
          <ProductCard
            name={p.data.name}
            slug={p.id}
            price={p.data.price}
            priceMax={p.data.priceMax}
            image={p.data.image}
            category={p.data.category}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Arrived from the listing? Go back in history instead, so its filter, search and scroll
  // position come back too. Otherwise (direct link, search engine) the plain link is right.
  const back = document.getElementById('back-link') as HTMLAnchorElement;
  back.addEventListener('click', (e) => {
    const from = document.referrer && new URL(document.referrer);
    if (from && from.origin === location.origin && from.pathname.replace(/\/$/, '') === back.pathname.replace(/\/$/, '')) {
      e.preventDefault();
      history.back();
    }
  });
</script>
