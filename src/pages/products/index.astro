---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { getCollection } from 'astro:content';

// Newest first; products published together keep their alphabetical order (the sort is stable).
const allProducts = (await getCollection('products', ({ data }) => !data.archive)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const categories = await getCollection('categories');

const counts = new Map<string, number>();
for (const p of allProducts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
// Biggest categories first, so the ones people want are at the start of the swipeable row
const categoryList = categories
  .filter((c) => counts.has(c.data.slug))
  .map((c) => ({ slug: c.data.slug, name: c.data.name, count: counts.get(c.data.slug)! }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'hr'));
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Proizvodi" description="Pregledajte našu ponudu poklona, suvenira i drugih proizvoda.">
  <section class="pt-10 pb-16 md:pt-14 md:pb-20 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-4xl md:text-5xl mb-6">Proizvodi</h1>

      <div id="search" class="mb-6"></div>
      <link href={`${base}pagefind/pagefind-ui.css`} rel="stylesheet" />
      <style is:global>
        #search .pagefind-ui__result-thumb {
          cursor: pointer;
        }
      </style>
      <script is:inline src={`${base}pagefind/pagefind-ui.js`}></script>
      <script is:inline define:vars={{ base }}>
        window.addEventListener('DOMContentLoaded', () => {
          new PagefindUI({ element: '#search', showSubResults: false, basePath: base + 'pagefind/' });

          // Make result thumbnails link to the product, like the title does.
          // Results render dynamically as you type, so delegate from the container.
          document.getElementById('search').addEventListener('click', (e) => {
            const thumb = e.target.closest('.pagefind-ui__result-thumb');
            if (!thumb) return;
            const result = thumb.closest('.pagefind-ui__result');
            const link = result && result.querySelector('.pagefind-ui__result-link');
            if (link && link.href) window.location.href = link.href;
          });
        });
      </script>

      <CategoryFilter categories={categoryList} />
      <ProductGrid products={allProducts} />

      {allProducts.length === 0 && (
        <p class="text-center text-muted-foreground py-12">Nema proizvoda za prikaz.</p>
      )}
    </div>
  </section>
</BaseLayout>
