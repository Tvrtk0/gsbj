---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { getCollection } from 'astro:content';

// Newest first; products published together keep their alphabetical order (the sort is stable).
const allProducts = (await getCollection('products', ({ data }) => !data.archive)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const categories = await getCollection('categories');

const counts = new Map<string, number>();
for (const p of allProducts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
// Biggest categories first, so the ones people want are at the start of the swipeable row
const categoryList = categories
  .filter((c) => counts.has(c.data.slug))
  .map((c) => ({ slug: c.data.slug, name: c.data.name, count: counts.get(c.data.slug)! }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'hr'));
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Proizvodi" description="Pregledajte našu ponudu poklona, suvenira i drugih proizvoda.">
  <section class="pt-10 pb-16 md:pt-14 md:pb-20 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <h1 class="animate-enter text-4xl md:text-5xl mb-6" style="--i: 0">Proizvodi</h1>

      {/* Search over the Pagefind index; results show as the cards below (src/scripts/catalog.ts) */}
      <form role="search" class="animate-enter relative max-w-xl mb-6" style="--i: 1" onsubmit="return false">
        <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"/></svg>
        <input
          id="search-input"
          type="search"
          name="q"
          placeholder="Traži proizvode"
          autocomplete="off"
          enterkeyhint="search"
          aria-label="Traži proizvode"
          class="w-full h-12 pl-11 pr-11 rounded-xl bg-card text-base text-foreground placeholder:text-muted-foreground/70 ring-1 ring-border focus:ring-2 focus:ring-primary outline-none transition-shadow"
        />
        <button
          id="search-clear"
          type="button"
          hidden
          aria-label="Očisti pretragu"
          class="absolute right-2 top-1/2 -translate-y-1/2 p-2 rounded-lg text-muted-foreground hover:text-foreground"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </form>
      <p id="search-status" hidden class="mb-6 text-sm font-medium text-muted-foreground" aria-live="polite"></p>

      <CategoryFilter categories={categoryList} />
      <ProductGrid products={allProducts} />
      <script is:inline>
        // Apply the URL's state before first paint rather than waiting for catalog.ts, so the
        // first frame already shows the right cards: no layout shift, and coming back from a
        // product its card is on screen for the photo to morph into (view transition).
        (() => {
          const params = new URLSearchParams(location.search);
          const grid = document.getElementById('product-grid');
          if (params.get('q')) {
            // Search results arrive after Pagefind loads; hide the default grid meanwhile
            document.getElementById('category-filter').hidden = true;
            grid.style.visibility = 'hidden';
            return;
          }
          const category = params.get('category');
          if (!category) return;
          const limit = Math.max(24, Number(history.state && history.state.limit) || 24);
          let shown = 0;
          for (const card of grid.children) {
            const show = card.dataset.category === category && shown < limit;
            card.style.display = show ? '' : 'none';
            if (show) shown++;
          }
        })();
      </script>

      <div id="search-empty" hidden class="text-center py-16">
        <p class="text-lg font-medium">Nema rezultata za „<span data-term></span>“</p>
        <p class="mt-1 text-muted-foreground">Provjerite pravopis ili pokušajte s kraćim pojmom.</p>
        <button type="button" class="mt-5 inline-flex px-5 py-2.5 rounded-xl bg-card ring-1 ring-border font-medium hover:ring-primary hover:text-primary transition-colors">
          Očisti pretragu
        </button>
      </div>

      {allProducts.length === 0 && (
        <p class="text-center text-muted-foreground py-12">Nema proizvoda za prikaz.</p>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/catalog';
</script>
